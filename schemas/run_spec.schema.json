{
  "$defs": {
    "BudgetSpec": {
      "additionalProperties": false,
      "description": "Hard budget limits for one DTE run.",
      "properties": {
        "allocation_mass_per_iteration": {
          "default": 3,
          "maximum": 50,
          "minimum": 1,
          "title": "Allocation Mass Per Iteration",
          "type": "integer"
        },
        "continuation_policy": {
          "default": "bounded_node_yield_v1",
          "enum": [
            "legacy_entropy_v1",
            "bounded_node_yield_v1"
          ],
          "title": "Continuation Policy",
          "type": "string"
        },
        "entropy_change_threshold": {
          "default": 0.05,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Entropy Change Threshold",
          "type": "number"
        },
        "entropy_plateau_confirmations": {
          "default": 2,
          "maximum": 10,
          "minimum": 1,
          "title": "Entropy Plateau Confirmations",
          "type": "integer"
        },
        "max_children_per_iteration": {
          "default": 5,
          "maximum": 50,
          "minimum": 1,
          "title": "Max Children Per Iteration",
          "type": "integer"
        },
        "max_committed_search_nodes": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Committed Search Nodes",
          "type": "integer"
        },
        "max_iterations": {
          "default": 10,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Iterations",
          "type": "integer"
        },
        "max_relation_enrichment_pairs": {
          "default": 3,
          "maximum": 100,
          "minimum": 0,
          "title": "Max Relation Enrichment Pairs",
          "type": "integer"
        },
        "max_relation_pairs_per_episode": {
          "default": 3,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Relation Pairs Per Episode",
          "type": "integer"
        },
        "max_research_iterations": {
          "default": 1,
          "maximum": 5,
          "minimum": 0,
          "title": "Max Research Iterations",
          "type": "integer"
        },
        "min_iterations_before_synthesis": {
          "default": 2,
          "maximum": 20,
          "minimum": 1,
          "title": "Min Iterations Before Synthesis",
          "type": "integer"
        },
        "t_max": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "maximum": 10.0,
          "title": "T Max",
          "type": "number"
        }
      },
      "title": "BudgetSpec",
      "type": "object"
    },
    "CoverageObligation": {
      "additionalProperties": false,
      "description": "Structured, domain-neutral synthesis coverage required by a run.",
      "properties": {
        "coverage_id": {
          "minLength": 1,
          "title": "Coverage Id",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "coverage_id"
      ],
      "title": "CoverageObligation",
      "type": "object"
    },
    "OperatorPolicy": {
      "additionalProperties": false,
      "description": "Narrow delegation policy for privileged controller commands.",
      "properties": {
        "main_agent_may_request_synthesis": {
          "default": true,
          "title": "Main Agent May Request Synthesis",
          "type": "boolean"
        }
      },
      "title": "OperatorPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Top-level run specification.\n\nThis is the source of truth. Free-form Markdown or prompt text cannot\noverride this object after validation.",
  "properties": {
    "allow_self_organized_executor": {
      "default": true,
      "title": "Allow Self Organized Executor",
      "type": "boolean"
    },
    "budget": {
      "$ref": "#/$defs/BudgetSpec"
    },
    "constraints": {
      "items": {
        "type": "string"
      },
      "title": "Constraints",
      "type": "array"
    },
    "coverage_obligations": {
      "items": {
        "$ref": "#/$defs/CoverageObligation"
      },
      "title": "Coverage Obligations",
      "type": "array"
    },
    "embedding_dimension": {
      "default": 3072,
      "maximum": 3072,
      "minimum": 8,
      "title": "Embedding Dimension",
      "type": "integer"
    },
    "embedding_provider": {
      "default": "hash",
      "enum": [
        "hash",
        "gemini-embedding-2"
      ],
      "title": "Embedding Provider",
      "type": "string"
    },
    "goal": {
      "minLength": 1,
      "title": "Goal",
      "type": "string"
    },
    "material_provenance_policy": {
      "default": "terminal_disclosure",
      "enum": [
        "terminal_disclosure",
        "strict_repair"
      ],
      "title": "Material Provenance Policy",
      "type": "string"
    },
    "mode": {
      "const": "mandatory_frontier",
      "default": "mandatory_frontier",
      "title": "Mode",
      "type": "string"
    },
    "operator_policy": {
      "$ref": "#/$defs/OperatorPolicy"
    },
    "problem": {
      "minLength": 1,
      "title": "Problem",
      "type": "string"
    },
    "require_final_synthesis": {
      "default": true,
      "title": "Require Final Synthesis",
      "type": "boolean"
    },
    "role_isolation_mode": {
      "default": "legacy_unverified",
      "enum": [
        "strict_fresh_context",
        "shared_context_single_agent",
        "legacy_unverified"
      ],
      "title": "Role Isolation Mode",
      "type": "string"
    }
  },
  "required": [
    "problem",
    "goal"
  ],
  "title": "DTERunSpec",
  "type": "object"
}
